# https://github.com/community-charts/helm-charts/blob/main/charts/n8n/values.yaml

# Test build, applies to main, worker and webhook pods (not task runners).
# The tag is mutable, so always re-pull on pod restart.
image:
  repository: registry.mkz.me/mycroft/n8n
  tag: dev-unlock
  pullPolicy: Always

db:
  type: postgresdb

externalRedis:
  host: "{{ .CustomValues.Redis }}"
  port: 6379

externalPostgresql:
  host: postgres-rw.cnpg
  port: 5432
  username: n8n
  database: n8n
  existingSecret: postgresql-cnpg

ingress:
  enabled: true
  className: traefik
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
  hosts:
    - host: n8n.iop.cx
      paths:
        - path: /
          pathType: Prefix
  tls:
    - hosts:
        - n8n.iop.cx
      secretName: secret-tls-n8n

worker:
  mode: regular

webhook:
  mode: regular

taskRunners:
  mode: external
  external:
    image:
      # Must match the n8n version of the test image above (2.44.0).
      tag: "2.44.0"

nodes:
  python:
    enabled: true

binaryData:
  mode: filesystem

# Explicit values to silence n8n startup deprecation warnings and pin current
# defaults ahead of future breaking-default changes.
extraEnvVars:
  N8N_WEBHOOK_URL: "https://n8n.iop.cx"
  N8N_UNVERIFIED_PACKAGES_ENABLED: "false"
  N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES: "2147483648"
  N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES: "5000"
  N8N_DEV_UNLOCK_ALL_FEATURES: "true"
  # SSO via authentik (application slug "n8n"). Client ID and secret come
  # from the "oidc" secret below. Managed by env: n8n reapplies these on
  # every start and locks the SSO settings in the UI.
  N8N_SSO_MANAGED_BY_ENV: "true"
  N8N_SSO_OIDC_LOGIN_ENABLED: "true"
  N8N_SSO_OIDC_DISCOVERY_ENDPOINT: "https://auth.services.mkz.me/application/o/n8n/.well-known/openid-configuration"

extraSecretNamesForEnvFrom:
  - oidc

# https://github.com/containers/kubernetes-mcp-server/blob/main/charts/kubernetes-mcp-server/values.yaml
# The ClusterRole and the NetworkPolicy are created in
# charts/apps/kubernetes-mcp-server.go.

image:
  # The chart defaults to latest.
  version: {{ ImageTag "quay.io/containers/kubernetes_mcp_server" }}

# Only agent-nexus calls it, from inside the cluster.
ingress:
  enabled: false

# config.toml. The server refuses Secrets on its own too, and only offers
# read-only tools; helm is left out, as it reads releases from Secrets.
config:
  read_only: true
  toolsets: [core]
  denied_resources:
    - group: ""
      version: v1
      kind: Secret

metrics:
  serviceMonitor:
    enabled: true
    labels:
      release: prometheus

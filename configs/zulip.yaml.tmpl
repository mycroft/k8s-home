# https://github.com/zulip/docker-zulip/blob/main/helm/zulip/values.yaml
# Settings: https://zulip.readthedocs.io/projects/docker/en/latest/reference/environment-vars.html
# The ingress, Redis, RabbitMQ and memcached are created in
# charts/apps/zulip.go, which fills in the .CustomValues below.

zulip:
  environment:
    SETTING_EXTERNAL_HOST: "{{ .CustomValues.ExternalHost }}"
    SETTING_ZULIP_ADMINISTRATOR: pm@mkz.me
    SECRETS_secret_key:
      valueFrom:
        secretKeyRef:
          name: secret-key
          key: password
    # Traefik reaches Zulip from the pod network (k3s cluster-cidr); Zulip
    # only trusts X-Forwarded-* headers from these addresses.
    LOADBALANCER_IPS: 10.42.0.0/16
    # The database is in the daily postgres-dump of the CNPG cluster, and the
    # data volume (uploads, generated secrets) in Velero's filesystem backups.
    AUTO_BACKUP_ENABLED: "False"

    # Outgoing email, through the same relay as authentik. The relay's
    # certificate is for maki.mkz.me: STARTTLS to mail.mkz.me, the same
    # server, fails verification.
    SETTING_EMAIL_HOST: maki.mkz.me
    SETTING_EMAIL_PORT: "587"
    SETTING_EMAIL_USE_TLS: "True"
    SETTING_EMAIL_HOST_USER:
      valueFrom:
        secretKeyRef:
          name: mailrelay
          key: username
    SECRETS_email_password:
      valueFrom:
        secretKeyRef:
          name: mailrelay
          key: password
    # A single fixed sender: by default Zulip adds a random token to it.
    SETTING_NOREPLY_EMAIL_ADDRESS: zulip@mkz.me
    SETTING_ADD_TOKENS_TO_NOREPLY_ADDRESS: "False"

    # Login through authentik (OIDC), besides email and password; the
    # authentik provider and application are described in
    # charts/apps/zulip.go. The IdP setting is Python, appended as is to
    # Zulip's settings.py, where get_secret reads the secret below.
    # auto_signup creates the Zulip account on a first authentik login.
    ZULIP_AUTH_BACKENDS: EmailAuthBackend,GenericOpenIdConnectBackend
    SETTING_SOCIAL_AUTH_OIDC_ENABLED_IDPS: |-
      {
          "authentik": {
              "oidc_url": "https://auth.services.mkz.me/application/o/zulip/",
              "display_name": "authentik",
              "display_icon": None,
              "client_id": "zulip",
              "secret": get_secret("social_auth_oidc_secret"),
              "auto_signup": True,
          }
      }
    # Names come from authentik, and cannot be changed in Zulip.
    SETTING_SOCIAL_AUTH_OIDC_FULL_NAME_VALIDATED: "True"
    SECRETS_social_auth_oidc_secret:
      valueFrom:
        secretKeyRef:
          name: oidc
          key: client_secret

  persistence:
    storageClass: longhorn-crypto-global
    size: 10Gi

# Zulip only answers once its container is configured and every database
# migration has run, which on the first start takes several minutes. Allow 10
# instead of the chart's 5, so the probe cannot kill a migration in progress.
# The HelmRelease timeout in charts/apps/zulip.go covers it.
startupProbe:
  failureThreshold: 60

postgresql:
  enabled: false
externalPostgresql:
  host: postgres-rw.cnpg
  port: 5432
  database: zulip
  user: zulip
  password:
    valueFrom:
      secretKeyRef:
        name: postgresql
        key: password

rabbitmq:
  enabled: false
externalRabbitmq:
  host: "{{ .CustomValues.RabbitMQ }}"
  port: 5672
  user: zulip
  password:
    valueFrom:
      secretKeyRef:
        name: rabbitmq
        key: password

# Neither has a password; Zulip then skips authentication.
memcached:
  enabled: false
externalMemcached:
  host: "{{ .CustomValues.Memcached }}"
  port: 11211
  password: ""

redis:
  enabled: false
externalRedis:
  host: "{{ .CustomValues.Redis }}"
  port: 6379
  password: ""

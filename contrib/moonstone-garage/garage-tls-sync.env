# Installed as /etc/default/garage-tls-sync. Every variable is optional; the values
# below are the defaults built into garage-tls-sync.

#API_SERVER=https://star-train.lan.mkz.me:6443
#NAMESPACE=moonstone-garage
#SECRET=s3-tls
#TOKEN_FILE=/etc/garage-tls/sa/token
#CA_FILE=/etc/garage-tls/sa/ca.crt
#DEST_DIR=/etc/garage-tls

# Group allowed to read tls.key, e.g. the proxy's group when it does not run as root.
#KEY_GROUP=root

# Run after a new certificate is installed, e.g. "systemctl reload nginx".
#RELOAD_COMMAND=

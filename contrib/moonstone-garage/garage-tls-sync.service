[Unit]
Description=Sync the Garage S3 TLS certificate from the k8s-home cluster
Documentation=https://git.mkz.me/mycroft/k8s-home/src/branch/main/docs/garage.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/garage-tls-sync
ExecStart=/usr/local/bin/garage-tls-sync
ProtectSystem=strict
# Creates /etc/garage-tls when missing and keeps it writable under ProtectSystem=strict.
ConfigurationDirectory=garage-tls
ConfigurationDirectoryMode=0755
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
